# ==============================================================================
# Checkease - Environment Configuration Template
# Sao chép file này thành .env và cập nhật các giá trị phù hợp với môi trường của bạn:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=checkease_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
# Sử dụng "localhost" khi chạy Django ngoài máy host, hoặc "db" khi chạy trong Docker Compose
POSTGRES_HOST=localhost

# ------------------------------------------------------------------------------
# 3. Redis & Celery Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
# Với Local Dev (máy host): redis://127.0.0.1:6379/0
# Với Docker Compose: redis://redis:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. MinIO Object Storage Configuration
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET_NAME=artifact
# Endpoint backend kết nối tới MinIO
# Với Local Dev: http://localhost:9000 | Với Docker Compose: http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
# Endpoint public để trình duyệt upload file qua Presigned URL
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# ------------------------------------------------------------------------------
# 5. Google Gemini AI (Optional - Phân tích ngữ nghĩa & Giải thích lỗ hổng AI)
# ------------------------------------------------------------------------------
# Đăng ký và lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
